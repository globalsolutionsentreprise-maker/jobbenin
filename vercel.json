{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/offre/:id", "destination": "/api/jobs?render=offre&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/jobs?render=sitemap" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/presentation.html",
      "permanent": false
    },
    {
      "source": "/bienvenue.html",
      "destination": "/presentation.html",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/payment/check-inactivity",
      "schedule": "0 6 * * *"
    }
  ]
}
