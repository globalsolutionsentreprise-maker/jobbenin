{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/presentation.html",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/payment/check-inactivity",
      "schedule": "0 6 * * *"
    }
  ]
}
